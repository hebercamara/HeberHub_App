# Copie para .env.local e preencha com os dados do app Web no console do Firebase
# (Configurações do projeto > Seus apps > Configuração do SDK).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Nome do ambiente exibido no app (dev ou prod)
VITE_APP_ENV=dev

# true = usa os emuladores locais do Firebase em vez do projeto real
VITE_USE_EMULATORS=true
