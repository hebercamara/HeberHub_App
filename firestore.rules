rules_version = '2';

// Toda escrita passa pelas Cloud Functions. O app só lê, e cada perfil lê
// apenas o que lhe cabe. O perfil vem dos custom claims do login.
service cloud.firestore {
  match /databases/{database}/documents {
    function logado() {
      return request.auth != null;
    }
    function perfil() {
      return request.auth.token.get('perfil', '');
    }
    // Gestão vê tudo; Jurídico lê tudo (só altera contratos, pelas funções).
    function equipe() {
      return logado() && perfil() in ['adm', 'coordenacao', 'gestao', 'juridico'];
    }
    function coordenacao() {
      return logado() && perfil() in ['coordenacao', 'gestao', 'juridico'];
    }
    // Gestão, coordenação, Jurídico e ADM Financeiro: os únicos que veem valores.
    function financeiro() {
      return equipe() && request.auth.token.get('financeiro', false) == true;
    }

    match /usuarios/{uid} {
      allow read: if logado() && (request.auth.uid == uid || equipe());
    }

    // Cadastro oficial (empresa, representante, Receita): o próprio e a equipe.
    match /cadastrosOficiais/{uid} {
      allow read: if logado() && (request.auth.uid == uid || equipe());
      // Histórico de versões do Cadastro Oficial: a equipe.
      match /versoes/{versao} {
        allow read: if equipe();
      }
    }
    // Conta e PIX: o próprio e quem vê valores. O ADM comum não vê.
    match /dadosBancarios/{uid} {
      allow read: if logado() && (request.auth.uid == uid || financeiro());
    }

    // Planilha de prestadores atuais (pré-cadastros) e relatórios: coordenação.
    match /preCadastros/{cnpj} {
      allow read: if coordenacao();
    }
    match /importacoes/{id} {
      allow read: if coordenacao();
    }

    match /bases/{baseId} {
      allow read: if logado();
    }

    // Prestador lê só as próprias presenças; ADM e coordenação leem todas.
    match /presencas/{presencaId} {
      allow read: if logado() && (resource.data.uid == request.auth.uid || equipe());
    }

    // Falta e não escalado: a equipe vê no calendário.
    match /ausencias/{id} {
      allow read: if equipe();
    }

    // Cadastros operacionais: nomes, sem valores.
    match /operacoes/{id} {
      allow read: if equipe();
      // Roteiros, modalidades e brokers da operação (Diário de Campo).
      match /{lista}/{item} {
        allow read: if equipe() && lista in ['roteiros', 'modalidades', 'brokers'];
      }
    }
    match /funcoes/{id} {
      allow read: if equipe();
    }

    // Veículos (da casa e dos agregados) e a equipe de cada agregado: a equipe.
    match /veiculos/{placa} {
      allow read: if equipe();
    }
    match /veiculos/{placa}/manutencoes/{id} {
      allow read: if equipe();
    }
    match /agregados/{uid}/equipe/{id} {
      allow read: if equipe();
    }
    // CNH de quem dirige (preenchida pela equipe) e regiões de entrega: a equipe.
    match /cnhs/{uid} {
      allow read: if equipe();
    }
    match /regioes/{id} {
      allow read: if equipe();
    }

    // Tudo que tem dinheiro.
    match /valoresAgregado/{id} {
      allow read: if financeiro();
    }
    // Desconto do agregado e adicional de viagem de cada operação.
    match /valoresOperacao/{id} {
      allow read: if financeiro();
    }
    match /valoresDiaria/{id} {
      allow read: if financeiro();
    }
    match /lancamentos/{id} {
      allow read: if financeiro();
    }
    match /eventos/{id} {
      allow read: if financeiro();
    }
    match /fechamentos/{competencia} {
      allow read: if financeiro();
    }

    // Contratos: modelos, documentos emitidos e dados da contratante: a equipe
    // (o ADM emite os modelos liberados para ele). Versões antigas dos modelos: coordenação.
    match /modelosDocumento/{id} {
      allow read: if equipe();
      match /versoes/{versao} {
        allow read: if coordenacao();
      }
    }
    match /documentos/{id} {
      allow read: if equipe();
    }
    match /configuracoes/contratante {
      allow read: if equipe();
    }

    // Cores do sistema: públicas (aparecem até na tela de login).
    match /configuracoes/aparencia {
      allow read: if true;
    }

    // Eventos de presença (regras e valores): só a coordenação.
    match /eventosPresenca/{id} {
      allow read: if coordenacao();
    }

    match /auditoria/{registroId} {
      allow read: if coordenacao();
    }

    // sessoes (tokens do QR) e qualquer outra coleção: sem acesso pelo app.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
