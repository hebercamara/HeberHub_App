rules_version = '2';

// Fase 0: tudo fechado. As regras de cada coleção entram na Fase 1,
// junto com os perfis (prestador, adm, coordenacao) nos custom claims.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
